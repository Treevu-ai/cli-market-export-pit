# Cross-origin PIT API base (only needed when the frontend and backend run on
# different origins, e.g. production split into two Fly apps).
NEXT_PUBLIC_PIT_API_URL=http://localhost:8000

# CLI Market platform credentials, used server-side only by lib/cli-market-stats.ts
# to render live hero stats. Never exposed to the client bundle.
CLIMARKET_API_KEY=
CLIMARKET_API_URL=https://cli-market-api.fly.dev
